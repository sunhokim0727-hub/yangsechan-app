{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('nickname').isString() && newData.child('nickname').val().length >= 1 && newData.child('nickname').val().length <= 12"
      }
    },
    "abuseReports": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('reporterUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['reporterUid', 'targetUid', 'reason', 'ts']) && newData.child('reason').isString() && newData.child('reason').val().length <= 30 && newData.child('text').val().length <= 200"
      }
    },
    "publicRooms": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$code": {
        ".write": "auth != null && (root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid || (!newData.exists() && (!root.child('rooms').child($code).child('meta').exists() || (root.child('rooms').child($code).child('meta').child('lastSeen').exists() && root.child('rooms').child($code).child('meta').child('lastActivity').exists() && (now - root.child('rooms').child($code).child('meta').child('lastSeen').val() > 300000 || now - root.child('rooms').child($code).child('meta').child('lastActivity').val() > 600000)))))",
        "playerCount": {
          ".write": "auth != null"
        },
        ".validate": "newData.hasChildren(['hostName', 'status'])",
        "lastSeen": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        },
        "lastActivity": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        }
      }
    },
    "rooms": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('hostId').val() === auth.uid)",
          "hostId": {
            ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('players').child(root.child('rooms').child($code).child('meta').child('hostId').val()).child('online').val() === false && newData.val() === auth.uid"
          },
          "hostName": {
            ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('players').child(root.child('rooms').child($code).child('meta').child('hostId').val()).child('online').val() === false"
          },
          ".validate": "newData.hasChildren(['hostId', 'mode'])",
          "lastSeen": {
            ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
          },
          "lastActivity": {
            ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
          }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && !root.child('rooms').child($code).child('kicked').child($uid).exists()) || root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid)",
            ".validate": "newData.child('nickname').isString() && newData.child('nickname').val().length <= 12"
          }
        },
        "kicked": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid"
          }
        },
        "muted": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid"
          }
        },
        "chat": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "$id": {
            ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && !data.exists() && newData.exists() && ((newData.child('uid').val() === auth.uid && !root.child('rooms').child($code).child('muted').child(auth.uid).exists() && (!root.child('rooms').child($code).child('game').child('players').exists() || root.child('rooms').child($code).child('game').child('players').child(auth.uid).exists())) || (newData.child('kind').val() === 'sys' && newData.child('uid').val() === 'sys'))",
            ".validate": "newData.hasChildren(['uid', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length <= 200",
            "correct": {
              ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta').child('mode').val() === 'online'"
            },
            "invalid": {
              ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta').child('mode').val() === 'online'"
            }
          }
        },
        "words": {
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && ((root.child('rooms').child($code).child('meta').child('mode').val() === 'same' && auth.uid === $uid) || (!(root.child('rooms').child($code).child('meta').child('mode').val() === 'same') && auth.uid !== $uid))",
            ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid"
          }
        },
        "game": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "results": {
            "$uid": {
              ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && !data.exists() && ((root.child('rooms').child($code).child('meta').child('mode').val() === 'same' && auth.uid === $uid) || root.child('rooms').child($code).child('meta').child('mode').val() === 'online')",
              ".validate": "newData.hasChildren(['at'])"
            }
          },
          "left": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
            }
          },
          "turn": {
            ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta').child('mode').val() === 'online'"
          }
        },
        "wordHashes": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid"
        },
        "reports": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "$msg": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($code).child('players').child(auth.uid).exists() && (!root.child('rooms').child($code).child('game').child('players').exists() || root.child('rooms').child($code).child('game').child('players').child(auth.uid).exists()) && root.child('rooms').child($code).child('chat').child($msg).child('uid').val() !== auth.uid"
            }
          }
        },
        ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('meta').child('lastSeen').exists() && root.child('rooms').child($code).child('meta').child('lastActivity').exists() && (now - root.child('rooms').child($code).child('meta').child('lastSeen').val() > 300000 || now - root.child('rooms').child($code).child('meta').child('lastActivity').val() > 600000)"
      }
    }
  }
}