{
  "appId": "com.sunho.yangsechan",
  "appName": "제시어게임",
  "webDir": "www",
  "backgroundColor": "#5B2FE0",
  "android": {
    "backgroundColor": "#5B2FE0",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 500,
      "backgroundColor": "#5B2FE0",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#5B2FE0"
    }
  }
}
